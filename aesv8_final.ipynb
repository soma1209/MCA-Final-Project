    "    coverage=(\"covered\", \"mean\"),\n",
    "    avg_width=(\"interval_width\", \"mean\"),\n",
    "    avg_confidence=(\"confidence_score\", \"mean\")\n",
    ").round(3)\n",
    "\n",
    "display(coverage_by_set)\n",
    "\n",
    "if overall_coverage < (1 - CQR_ALPHA) - 0.03:\n",
